# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

# Auth (generate with: openssl rand -base64 32). The app refuses to start with fewer than 32 characters or with this placeholder.
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_MAX_AGE_DAYS=7

# App
# The site's public address, no trailing slash. Canonical links, the sitemap, robots.txt, Open Graph and llms.txt are all
# built from it (falls back to Render's RENDER_EXTERNAL_URL, then to http://localhost:3000). On the live site it is
# https://tarmoq-uz.onrender.com today; when a real domain is bought, change this one value.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional: verification codes from Google Search Console and Yandex Webmaster (only the code, not the whole tag).
# Empty = nothing is added to the pages.
GOOGLE_SITE_VERIFICATION=""
YANDEX_VERIFICATION=""

# Optional: email (password reset, address confirmation) through resend.com. Both empty = those features stay hidden.
# MAIL_DRIVER="log" prints mail in the server log instead (development only).
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_DRIVER=""

# Profile photos, when STORAGE_DRIVER="s3": their own private bucket.
S3_AVATARS_BUCKET=""

# Payments:
#   "sandbox" = test cards, no real money (the default).
#   "manual"  = REAL money moved by hand: clients send the agreed amount to the card below, press "I paid", and an
#               admin confirms it in /admin/payments after seeing the money in the bank app. Creators are paid by hand
#               from /admin/payouts. Test cards are switched off in this mode.
#   "whop"    = only the online card payment through Whop (below).
# Payme, Click and Uzum are not implemented.
PAYMENT_PROVIDER="sandbox"

# Only for PAYMENT_PROVIDER="manual". The card clients send money to. Set real values in the host's dashboard, never commit them.
MANUAL_PAY_CARD=""
MANUAL_PAY_HOLDER=""
MANUAL_PAY_BANK=""

# Online card payment through Whop. The button appears when the first three are set and PAYMENT_PROVIDER is "manual"
# (beside the card transfer) or "whop" (alone). Webhook address: <site>/api/payments/whop/webhook, event
# payment.succeeded. The secrets go in the host's dashboard, never in git or chat.
WHOP_API_KEY=""
WHOP_ACCOUNT_ID=""
WHOP_WEBHOOK_SECRET=""
# Optional: a Whop product the payments are listed under.
WHOP_PRODUCT_ID=""
# Development only (ignored on a production server): "true" talks to sandbox.whop.com, where test cards work.
WHOP_SANDBOX=""

# Key for encrypting creators' payout card numbers (32 random bytes, base64: openssl rand -base64 32).
# In development, left empty, a key is derived from AUTH_SECRET. In production the app refuses to save a NEW card without it.
# Changing it (or AUTH_SECRET, when it is derived) later makes saved payout cards unreadable.
PAYOUT_ENCRYPTION_KEY=""

# Optional: Telegram message to the admin when a creator submits a profile for review (free Bot API).
# Create a bot with @BotFather for the token; message the bot once, then use your chat id (e.g. from @userinfobot).
# Leave both empty to switch it off. Never commit real values.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# File storage: "local" for dev, "s3" for production
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./.uploads"
MAX_UPLOAD_MB=100
# S3-compatible (production)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
# Bank receipts (manual payments). Optional: when empty they use S3_BUCKET. A bucket that only accepts video
# (as on Supabase) needs a separate one for JPG/PNG/WebP/PDF.
S3_RECEIPTS_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed. Categories are always seeded. Demo accounts and providers are created only when NODE_ENV is not
# "production", or when SEED_DEMO=true is set on purpose (staging). Never on the live site.
SEED_DEMO=false
SEED_DEMO_PASSWORD="Demo12345!"

# Tests only: switches the in-memory rate limiter off so the e2e suite can register many accounts.
# Ignored when NODE_ENV=production.
RATE_LIMIT_DISABLED=false
