# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_MAX_AGE_DAYS=7

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Payments:
#   "sandbox" = test cards, no real money (the default).
#   "manual"  = REAL money moved by hand: clients send the agreed amount to the card below, press "I paid", and an
#               admin confirms it in /admin/payments after seeing the money in the bank app. Creators are paid by hand
#               from /admin/payouts. Test cards are switched off in this mode.
# A real gateway (Payme, Click, Uzum) is not implemented yet.
PAYMENT_PROVIDER="sandbox"

# Only for PAYMENT_PROVIDER="manual". The card clients send money to. Set real values in the host's dashboard, never commit them.
MANUAL_PAY_CARD=""
MANUAL_PAY_HOLDER=""
MANUAL_PAY_BANK=""

# Optional: key for encrypting creators' payout card numbers (32 random bytes, base64: openssl rand -base64 32).
# Left empty, a key is derived from AUTH_SECRET. Changing either later makes saved payout cards unreadable.
PAYOUT_ENCRYPTION_KEY=""

# Optional: Telegram message to the admin when a creator submits a profile for review (free Bot API).
# Create a bot with @BotFather for the token; message the bot once, then use your chat id (e.g. from @userinfobot).
# Leave both empty to switch it off. Never commit real values.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# File storage: "local" for dev, "s3" for production
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./.uploads"
MAX_UPLOAD_MB=100
# S3-compatible (production)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed. Categories are always seeded. Demo accounts and providers are created only when NODE_ENV is not
# "production", or when SEED_DEMO=true is set on purpose (staging). Never on the live site.
SEED_DEMO=false
SEED_DEMO_PASSWORD="Demo12345!"

# Tests only: switches the in-memory rate limiter off so the e2e suite can register many accounts.
# Ignored when NODE_ENV=production.
RATE_LIMIT_DISABLED=false
