# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_MAX_AGE_DAYS=7

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Payments: "sandbox" only until a real gateway adapter is implemented
PAYMENT_PROVIDER="sandbox"
PLATFORM_FEE_PERCENT=10

# File storage: "local" for dev, "s3" for production
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./.uploads"
MAX_UPLOAD_MB=100
# S3-compatible (production)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed (demo accounts, dev only)
SEED_DEMO_PASSWORD="Demo12345!"
