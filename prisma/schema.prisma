generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum ProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  REQUESTED
  AGREEMENT_PENDING
  AWAITING_PAYMENT
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  AWAITING_CONFIRMATION // manual card transfer: the client says they paid, an admin has not confirmed yet
  HELD
  RELEASED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum LedgerType {
  ESCROW_HOLD
  PROVIDER_PAYOUT
  PLATFORM_FEE
  REFUND
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  /// Null for an account made through "Continue with Google": it has no password until the person sets one.
  passwordHash  String?
  /// Google's stable id for the person (the `sub` of the ID token). Set when they first sign in with Google.
  googleSub     String?  @unique
  name          String
  phone         String?
  role          Role     @default(CLIENT)
  isActive      Boolean  @default(true)
  /// Storage key of the profile photo (avatars/<userId>/<uuid>.<ext>). Server only: the client gets a URL built from the id and avatarUpdatedAt.
  avatarKey       String?
  /// When the photo last changed: "has a photo" and the cache-buster (?v=) of its URL. Null together with avatarKey.
  avatarUpdatedAt DateTime?
  /// Session version. A session cookie carries the number it was issued with (tv); a password change or "sign out everywhere" raises it and ends every older session.
  tokenVersion    Int      @default(0)
  /// When the person last used the site (written at most once a minute): online status and "last active".
  lastSeenAt      DateTime?
  /// When the address was confirmed through a link sent to it.
  emailVerifiedAt DateTime?
  /// Two-step sign-in: the authenticator secret (encrypted, src/lib/secretBox.ts), on once a code has been confirmed.
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  providerProfile ProviderProfile?
  clientOrders    Order[]          @relation("ClientOrders")
  providerOrders  Order[]          @relation("ProviderOrders")
  payouts         Payout[]         @relation("ProviderPayouts")
  messages        Message[]
  reviewsWritten  Review[]         @relation("ReviewAuthor")
  auditLogs       AuditLog[]
  notifications   Notification[]
  authTokens      AuthToken[]
  conversationsA  Conversation[]   @relation("ConvA")
  conversationsB  Conversation[]   @relation("ConvB")
}

model Category {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  /// The name a Russian reader sees. Null: the Uzbek name is shown.
  nameRu    String?
  profiles  ProviderProfile[]
}

model ProviderProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String        @unique
  headline       String
  bio            String
  city           String        @default("Andijon")
  district       String?
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  equipment      String?
  languages      String[]
  startingPrice  Int           // UZS, whole so'm
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  /// Orders completed, kept here so lists can show a level without counting.
  completedCount Int           @default(0)
  /// Visits to the public page by others.
  viewCount      Int           @default(0)
  status         ProfileStatus @default(DRAFT)
  wizardStep     Int           @default(1)
  // Where the platform sends this creator's money. Private: never selected for a public page.
  // The card number is stored encrypted (see src/lib/payoutSecret.ts); only the last 4 digits are kept in the clear.
  payoutHolder    String?
  payoutCardEnc   String?
  payoutCardLast4 String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  services  Service[]
  portfolio PortfolioItem[]

  @@index([city, status])
  @@index([categoryId, status])
  @@index([startingPrice])
}

model Service {
  id            String          @id @default(cuid())
  profileId     String
  profile       ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String
  price         Int             // UZS
  deliveryDays  Int
  revisions     Int             @default(1)
  isActive      Boolean         @default(true)
  /// A subdirection's slug (src/lib/catalog.ts); null when the creator chose none.
  subcategory   String?
  /// Questions every client answers when ordering this package.
  questions     String[]        @default([])
  /// The creator's own questions and answers about the package: [{ question, answer }].
  faq           Json?
  orders        Order[]
  offers        Offer[]

  @@index([profileId])
  @@index([subcategory])
}

model PortfolioItem {
  id         String          @id @default(cuid())
  profileId  String
  profile    ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title      String
  videoUrl   String?
  imageUrl   String?
  sortOrder  Int             @default(0)

  @@index([profileId])
}

model Order {
  id            String      @id @default(cuid())
  clientId      String
  client        User        @relation("ClientOrders", fields: [clientId], references: [id])
  providerId    String
  provider      User        @relation("ProviderOrders", fields: [providerId], references: [id])
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  brief         String
  eventDate     DateTime?
  /// The package's questions as asked when the order was made, with the client's answers: [{ question, answer }].
  answers       Json?
  agreedPrice   Int?        // set when terms proposed; UZS
  agreedDays    Int?
  revisionsAllowed Int      @default(1)
  revisionsUsed Int         @default(0)
  status        OrderStatus @default(REQUESTED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  completedAt   DateTime?
  /// When the work is due: set once the payment is held, moved by an accepted extension.
  dueAt         DateTime?

  requests    OrderRequest[]
  agreements  Agreement[]
  payments    Payment[]
  deliveries  Delivery[]
  review      Review?
  conversation Conversation?

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([serviceId])
}

model Agreement {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version            Int       @default(1)
  termsText          String
  termsHash          String    // sha256 of terms + price + days
  price              Int
  deliveryDays       Int
  clientAcceptedAt   DateTime?
  clientAcceptedIp   String?
  providerAcceptedAt DateTime?
  providerAcceptedIp String?
  createdAt          DateTime  @default(now())

  @@unique([orderId, version])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  amount      Int           // computed server-side from agreement
  currency    String        @default("UZS")
  status      PaymentStatus @default(REQUIRES_PAYMENT)
  provider    String        @default("sandbox")
  cardBrand   String?
  cardLast4   String?
  failureCode String?
  // Manual card transfer: the receipt the client uploaded when pressing "I paid" (stored like delivery files; admins only).
  receiptKey  String?
  receiptName String?
  receiptType String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ledger LedgerEntry[]
  payout Payout?

  @@index([orderId])
}

/// Money owed to a creator after the client approved the work. Created PENDING when the escrow is released;
/// an admin sends the money by hand and marks it PAID. Sandbox payments never create one (no real money).
model Payout {
  id         String       @id @default(cuid())
  paymentId  String       @unique
  payment    Payment      @relation(fields: [paymentId], references: [id])
  providerId String
  provider   User         @relation("ProviderPayouts", fields: [providerId], references: [id])
  amount     Int          // the creator's share (total minus the platform fee), whole so'm
  status     PayoutStatus @default(PENDING)
  paidAt     DateTime?
  paidById   String?
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@index([providerId, status])
}

model LedgerEntry {
  id         String     @id @default(cuid())
  paymentId  String
  payment    Payment    @relation(fields: [paymentId], references: [id])
  type       LedgerType
  amount     Int
  createdAt  DateTime   @default(now())

  @@index([paymentId])
}

model Delivery {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileKey   String
  fileName  String
  fileSize  Int
  mimeType  String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Conversation {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  userA     User      @relation("ConvA", fields: [userAId], references: [id])
  userB     User      @relation("ConvB", fields: [userBId], references: [id])
  orderId   String?   @unique
  order     Order?    @relation(fields: [orderId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]
  offers    Offer[]

  @@unique([userAId, userBId, orderId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  providerUserId String
  rating    Int      // 1..5, enforced in Zod + DB check in migration
  comment   String
  isHidden  Boolean  @default(false) // admin moderation
  /// The creator's one answer.
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())

  @@index([providerUserId, isHidden])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String   // e.g. AGREEMENT_ACCEPTED, PROVIDER_APPROVED
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([action, entityId])
}

enum RequestType {
  EXTEND
  CANCEL
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// One side asks the other to extend the deadline or to cancel the order.
model OrderRequest {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedById String
  type          RequestType
  extraDays     Int?
  reason        String
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?

  @@index([orderId])
}

/// A creator's offer of their own terms inside a conversation; accepting it makes an order.
model Offer {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerId     String
  clientId       String
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  description    String
  price          Int
  deliveryDays   Int
  revisions      Int
  status         OfferStatus  @default(PENDING)
  orderId        String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([conversationId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What happened; the sentence is built from it in the reader's language (src/lib/notificationsPure.ts).
  kind      String
  /// Where pressing it leads.
  href      String
  /// A name or title shown in the sentence.
  subject   String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A one-time link sent by email (password reset, address confirmation). Only the token's hash is kept.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}
